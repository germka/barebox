/dts-v1/;

#include <dt-bindings/soc/rockchip,vop2.h>

#include "rk3568-diasom-som.dtsi"

#define USBOTG_HOST

/ {
	model = "Diasom DS-RK3568-SOM-EVB";
	compatible = "diasom,ds-rk3568-som-evb",
		     "diasom,ds-rk3568-som",
		     "rockchip,rk3568";

	aliases {
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		mmc1 = &sdmmc0;
		gpio5 = &pcf8574a;
		rtc1 = &pcf85063;
		state = &state_node;
		mmc0 = &sdmmc0;
        mmc1 = &sdmmc1;
	};

    chosen {
        /* Магия автоматического переключения: */
        /* Если BootROM рапортует старт с mmc0 (eMMC), 
		bootsource смотрит на mmc0 */
        barebox,bootsource-mmc0 = &sdmmc0;
        /* Если BootROM рапортует старт с mmc1 (SD), 
		bootsource прозрачно переключается на mmc1 */
        barebox,bootsource-mmc1 = &sdmmc1;
    };

	state_node: state {
	        compatible = "barebox,state";
	        magic = <0x4c726d63>;
	
        	backend = <&sdmmc0>; 
	        backend-type = "raw";
			/* Благодаря этому GUID, Barebox найдет раздел и на SD, и на eMMC */
			backend-guid = "0657fd6d-a4ab-43c4-84e5-0933c84b4f4f";
	
			bootstate {
				#address-cells = <1>;
				#size-cells = <1>;
				/* Переменные bootchooser */
				system0 {
					/* Резервируем 16 байт под первый слот */
					reg = <0x0 0x10>;
					type = "uint32";
				};

				system1 {
					/* Резервируем следующие 16 байт под второй слот */
					reg = <0x10 0x10>;
					type = "uint32";
				};
			};
	    };

	clk25m: clk25m {
		compatible = "fixed-clock";
		clock-frequency = <25000000>;
		#clock-cells = <0>;
	};

	clk27m: clk27m {
		compatible = "fixed-clock";
		clock-frequency = <27000000>;
		#clock-cells = <0>;
	};

	clk37m125: clk37m125 {
		compatible = "fixed-clock";
		clock-frequency = <37125000>;
		#clock-cells = <0>;
	};

	vcc1v8_sys: vcc1v8-sys-regulator {
		compatible = "regulator-fixed";
		regulator-name = "1v8_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc3v3_sys>;
	};

	vcc3v3_pcie20: vcc3v3-pcie20-pwr-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		regulator-name = "3v3_pcie20";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <20000>;
		vin-supply = <&vcc3v3_sys>;
		status = "disabled";
	};

	vcc3v3_pcie30: vcc3v3-pcie30-regulator {
		pinctrl-names = "default";
		pinctrl-0 = <&pcie30_pwr_pins>;
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio3 RK_PD5 GPIO_ACTIVE_HIGH>;
		regulator-name = "3v3_pcie30";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <20000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc3v3_pi6c: vcc3v3-pi6c-regulator {
		pinctrl-names = "default";
		// pinctrl-0 = <&pcie30_oe_pins>;
		compatible = "regulator-fixed";
		/* Fixup for PCI-e in the bootloader */
		regulator-boot-on;
		// gpio = <&gpio3 RK_PD4 GPIO_ACTIVE_LOW>;
		regulator-name = "3v3_pi6c";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <20000>;
		vin-supply = <&vcc3v3_pcie30>;
		status = "disabled";
	};

	vcc5v0_usb3_host1: vcc5v0-usb3-host1-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		regulator-name = "vcc5v0_usb3_host1";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		startup-delay-us = <20000>;
		vin-supply = <&vcc5v0_sys>;
		regulator-always-on;
		status = "okay";
	};

	vcc5v0_usb3_otg0: vcc5v0-usb3-otg0-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb3_otg0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		startup-delay-us = <20000>;
		vin-supply = <&vcc5v0_sys>;
		regulator-always-on;
		status = "okay";
	};

	vcc_cam0: vcc-cam0-regulator {
		pinctrl-names = "default";
		pinctrl-0 = <&csi0_pwr>;
		compatible = "regulator-fixed";
		/* Used by RAW probe for cameras connected via I2C */
		regulator-boot-on;
		enable-active-high;
		// gpio = <&gpio2 RK_PD2 GPIO_ACTIVE_HIGH>;
		regulator-name = "vcc_cam0";
		startup-delay-us = <250000>;
		status = "disabled";
	};

	vcc_cam1: vcc-cam1-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		regulator-name = "vcc_cam1";
		startup-delay-us = <250000>;
		status = "disabled";
	};
};

/* === ЕДИНЫЙ ФИЗИЧЕСКИЙ БЛОК PHY0 (Здесь разведены оба устройства) === */
&usb2phy0 {
    status = "okay";
};

/* Линии хаба TUSB2077 (Аппаратный OTG0) */
&usb2phy0_otg {
	rockchip,vbus-always-on;
    status = "okay";
};

/* Линии модема LE910C1-EU (Аппаратный Host0) */
&usb2phy0_host {
	rockchip,vbus-always-on;
	status = "okay";
};

/* === КОНТРОЛЛЕР ХАБА TUSB2077 (Использует xHCI 0 + половину PHY0_OTG) === */
&usb_host0_xhci {
    dr_mode = "host";
    phys = <&usb2phy0_otg>;
    phy-names = "usb2-phy";
    maximum-speed = "high-speed";
    status = "okay";
};

&usb_host0_ehci {
    status = "okay";
};

/* === КОНТРОЛЛЕР МОДЕМА (Использует xHCI 1 + половину PHY0_HOST) === */
&usb_host1_xhci {
	dr_mode = "host";
	phys = <&usb2phy0_host>, <&combphy1 PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";
	status = "okay";
};

&usb_host1_ehci { status = "disabled"; };
&usb_host1_ohci { status = "disabled"; };

&combphy1 {
	status = "okay";
};

/* === НЕИСПОЛЬЗУЕМЫЙ ФИЗИЧЕСКИЙ БЛОК PHY1 (Полностью отключаем) === */
&usb2phy1 { status = "disabled"; };
&usb2phy1_host { status = "disabled"; };
&usb2phy1_otg { status = "disabled"; };

/* === РЕГУЛЯТОРЫ ПИТАНИЯ === */
&vcc5v0_usb3_host1 {
	compatible = "regulator-fixed";
	regulator-name = "vcc5v0_usb3_host1";
	regulator-min-microvolt = <5000000>;
	regulator-max-microvolt = <5000000>;
	regulator-always-on;
	regulator-boot-on;
	status = "okay";
};

&vcc5v0_usb3_otg0 {
	compatible = "regulator-fixed";
	regulator-name = "vcc5v0_usb3_otg0";
	regulator-min-microvolt = <5000000>;
	regulator-max-microvolt = <5000000>;
	regulator-always-on;
	regulator-boot-on;
	status = "okay";
};

&csi2_dphy0 {
	status = "disabled";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		port@1 {
			reg = <1>;

			csi_out: endpoint {
				remote-endpoint = <&isp_in>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

&csi2_dphy_hw {
	status = "disabled";
};

&display_subsystem {
	status = "disabled";
};

&gmac0 {
	assigned-clocks = <&cru SCLK_GMAC0_RX_TX>, <&cru SCLK_GMAC0>;
	assigned-clock-parents = <&cru SCLK_GMAC0_RGMII_SPEED>;
	assigned-clock-rates = <0>, <125000000>;
	pinctrl-names = "default";
	pinctrl-0 = <
		&gmac0_miim &gmac0_tx_bus2 &gmac0_rx_bus2
		&gmac0_rgmii_clk &gmac0_rgmii_bus
	>;
	clock_in_out = "output";
	phy-handle = <&rgmii_phy0>;
	phy-mode = "rgmii-id";
	phy-supply = <&vcc3v3_sys>;
};

&gmac1 {
	assigned-clocks = <&cru SCLK_GMAC1_RX_TX>, <&cru SCLK_GMAC1>;
	assigned-clock-parents = <&cru SCLK_GMAC1_RGMII_SPEED>;
	assigned-clock-rates = <0>, <125000000>;
	pinctrl-names = "default";
	pinctrl-0 = <
		&gmac1m1_miim &gmac1m1_tx_bus2 &gmac1m1_rx_bus2
		&gmac1m1_rgmii_clk &gmac1m1_rgmii_bus
	>;
	clock_in_out = "output";
	phy-handle = <&rgmii_phy1>;
	phy-mode = "rgmii-id";
	phy-supply = <&vcc3v3_sys>;
};

&gpu {
	status = "okay";
};

&sdhci {
    status = "okay";
    non-removable;
    bus-width = <8>;
};

&i2c1 {
	/* FUSB302 is not detected at 1MHz, so lets reduce frequency to 400KHz */
	clock-frequency = <400000>;
	status = "disabled";
};

&i2c4 {
	pinctrl-0 = <&i2c4m0_xfer>;
/*
	pinctrl-1 = <&i2c4m0_gpio>;
	pinctrl-names = "default", "recovery";
    recovery-gpios = <&gpio4 RK_PB2 GPIO_ACTIVE_HIGH>,
                     <&gpio4 RK_PB3 GPIO_ACTIVE_HIGH>;
 */
	resets = <&cru SRST_I2C4>;
    	reset-names = "i2c";
/*
	i2c-scl-rising-time-ns = <200>;
    i2c-scl-falling-time-ns = <200>;
    i2c-sda-holding-time-ns = <200>;
    retries = <3>;
    timeout-ms = <1000>;
 */
	clock-frequency = <100000>;
	multi-master;
	status = "okay";

	pcf8574a: gpio5@38 {
		compatible = "nxp,pcf8574a";
		reg = <0x38>;
		gpio-ranges = <&pinctrl 0 160 8>;
		interrupt-parent = <&irqpin2>;
		interrupts = <3 0>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
		gpio-line-names =
			"DI-1",
			"DI-2",
			"DI-3",
			"DI-4",
			"CAP good",
			"PWR good",
			"PWR fault",
			"CAP fault";
	};

	pcf85063: rtc@32 {
		compatible = "nxp,pcf85063";
		reg = <0x32>;
		quartz-load-femtofarads = <12500>;

		clock {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <32768>;
		};
	};

	eeprom@50 {
		compatible = "atmel,24c512";
		reg = <0x50>;
		pagesize = <128>;
	};
};

&isp {
	status = "disabled";
};

&isp_mmu {
	status = "disabled";
};

&isp_vir0 {
	status = "disabled";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp_in: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&csi_out>;
		};
	};
};

&mdio0 {
	rgmii_phy0: phy@0 {
		/* RTL8211F */
		pinctrl-names = "default";
		pinctrl-0 = <&gmac0_rst_pins>;
		compatible = "ethernet-phy-id001c.c916";
		reg = <0x0>;
		reset-assert-us = <20000>;
		reset-deassert-us = <100000>;
		reset-gpios = <&gpio2 RK_PD3 GPIO_ACTIVE_LOW>;
	};
};

&mdio1 {
	rgmii_phy1: phy@0 {
		/* RTL8211F */
		pinctrl-names = "default";
		pinctrl-0 = <&gmac1_rst_pins>;
		compatible = "ethernet-phy-id001c.c916";
		reg = <0x0>;
		reset-assert-us = <20000>;
		reset-deassert-us = <100000>;
		reset-gpios = <&gpio4 RK_PC1 GPIO_ACTIVE_LOW>;
	};
};

&pcie2x1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie20_pins>;
	reset-gpios = <&gpio1 RK_PB1 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie20>;
	status = "disabled";
};

&pcie30phy {
	data-lanes = <1 1>;
	phy-supply = <&vcc3v3_pi6c>;
	status = "disabled";
};

&pcie3x2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie30_pins>;
	reset-gpios = <&gpio4 RK_PC4 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pi6c>;
	status = "disabled";
};

&pwm5 {
	status = "disabled";
};

&rga {
	status = "disabled";
};

&sdmmc0 {
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
	bus-width = <4>;
	disable-wp;
	cd-gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&vcc3v3_sys>;
	status = "okay";
};

&spi1 {
	pinctrl-0 = <&spi1m1_pins_hs &spi1m1_cs0_hs>;
	num-cs = <1>;
	status = "disabled";

	spi@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
	};
};

&spi2 {
	pinctrl-0 = <&spi2m1_pins_hs &spi2m1_cs0_hs &spi2m1_cs1_hs>;
	num-cs = <2>;
	status = "disabled";

	spi@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
	};

	spi@1 {
		compatible = "rohm,dh2228fv";
		reg = <1>;
	};
};

// Slot-1
&uart5 {
	/delete-property/ dmas;
	pinctrl-0 = <&uart5m1_xfer>;
	status = "okay";
};

// Slot-2
&uart3 {
	/delete-property/ dmas;
	pinctrl-0 = <&uart3m1_xfer>;
	status = "okay";
};

// Slot-5 485-1
&uart7 {
	/delete-property/ dmas;
	pinctrl-0 = <&uart7m1_xfer &uart7m0_ctsn &uart7m0_rtsn>;
	linux,rs485-enabled-at-boot-time;
	rs485-rts-active-low;
	uart-has-rtscts;
	status = "okay";
};

// Slot-6 485-2
&uart8 {
	/delete-property/ dmas;
	pinctrl-0 = <&uart8m0_xfer &uart8m0_ctsn &uart8m0_rtsn>;
	linux,rs485-enabled-at-boot-time;
	rs485-rts-active-low;
	uart-has-rtscts;
	status = "okay";
};

// Slot-3
&uart9 {
	/delete-property/ dmas;
	pinctrl-0 = <&uart9m1_xfer>;
	status = "okay";
};

// Slot-4	// TODO: Fix levels
&uart4 {
	/delete-property/ dmas;
	pinctrl-0 = <&uart4m0_xfer>;
	status = "okay";
};

&vpu {
	status = "disabled";
};

&vdpu_mmu {
	status = "disabled";
};

&vepu {
	status = "disabled";
};

&vepu_mmu {
	status = "disabled";
};

&vop {
	status = "disabled";
};

&vop_mmu {
	status = "disabled";
};

&pinctrl {
	pinctrl-names = "default";
	pinctrl-0 = <&board_pins>;

	board {
		board_pins: board-pins {
			rockchip,pins =
				<1 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>;		/* GPIO_3 */
		};
	};

	csi {
		/* csi0 clkout = cif_clk */

		csi0_pwr: csi0-pwr-pins {
			rockchip,pins =
				<2 RK_PD2 RK_FUNC_GPIO &pcfg_pull_up>;		/* CSI_PWREN0 */
		};

		csi0_rst: csi0-rst-pins {
			rockchip,pins =
				<3 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>;		/* CSI_RESET0# */
		};
	};

	dsi {
		dsi_pins: dsi-pins {
			rockchip,pins =
				<0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>,		/* DSI_PWREN */
				<0 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>;		/* DSI_RESET# */
		};
	};

	lvds {
		lvds_pins: lvds-pins {
			rockchip,pins =
				<0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>;		/* LVDS_PWREN */
		};
	};

	net {
		gmac0_rst_pins: gmac0-rst-pins {
			rockchip,pins =
				<2 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>;	/* GMAC0_RST */
		};

		gmac1_rst_pins: gmac1-rst-pins {
			rockchip,pins =
				<4 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;	/* GMAC1_RST */
		};
	};

	pcie20 {
		pcie20_pins: pcie20-pins {
			rockchip,pins =
				<2 RK_PD0 4 &pcfg_pull_none>,			/* PCIE20_CLKREQn_M1 */
				<2 RK_PD1 4 &pcfg_pull_none>,			/* PCIE20_WAKEn_M1 */
				<1 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;	/* PCIE20_PERST */
		};
	};

	pcie30 {
		pcie30_pins: pcie30-pins {
			rockchip,pins =
				<4 RK_PC2 4 &pcfg_pull_none>,			/* PCIE30X2_CLKREQn_M2 */
				<4 RK_PC3 4 &pcfg_pull_none>,			/* PCIE30X2_WAKEn_M2 */
				<4 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>;		/* PCIE30X2_PERSTn_M2 */
		};

		pcie30_pwr_pins: pcie30-pwr-pins {
			rockchip,pins =
				<3 RK_PD5 RK_FUNC_GPIO &pcfg_pull_up>;		/* PCIE30_PWREN */
		};
	};
};

&pinctrl {
	usb_reset {
		mdm_reset_pin: mdm-reset-pin {
			/*
			* Настраиваем GPIO1_A3 как выход с низким уровнем.
			*/
			rockchip,pins = <1 RK_PA3 RK_FUNC_GPIO &pcfg_output_low>;
		};
	};
	i2c4_reset {
		i2c4m0_gpio: i2c4m0-gpio {
			rockchip,pins =
				<4 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>,  /* SDA */
				<4 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;  /* SCL */
		};
	};
};

&gpio0 {
	gpio-line-names = "","","","","","","","","","","","mdm-enable","","","","","","","","","","","","","","","","","","","","";
	 
	// mdm-enable {
	// 	gpio-hog;
	// 	gpios = <11 2>;	// line number in gpio port (not global)
	// 	output-low;
	// 	line-name = "mdm-enable";
	// };
};

&gpio1 {
	pinctrl-0 = <&mdm_reset_pin>;
    pinctrl-names = "default";

	compatible = "rockchip,gpio-bank";
	reg = <0x0 0xfe740000 0x0 0x100>;
	interrupts = <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>;
	clocks = <&cru PCLK_GPIO1>, <&cru DBCLK_GPIO1>;
	gpio-controller;
	gpio-ranges = <&pinctrl 0 32 32>;
	#gpio-cells = <2>;
	interrupt-controller;
	#interrupt-cells = <2>;
	gpio-line-names = "","hub-reset","","mdm-reset","","wl-enable","","","","pps-out","","","","","","","","","","","","","","","","","","","","","","";
	/*
	line_pps {
		gpio-hog;
		gpios = <9 2>;	// line number in gpio port (not global)
		output-high;
		line-name = "pps-out";
	};
	 */
	 
	// mdm-reset {
	// 	gpio-hog;
	// 	gpios = <3 2>;	// line number in gpio port (not global)
	// 	output-low;
	// 	line-name = "mdm-reset";
	// };

	wl-enable {
		gpio-hog;
		gpios = <5 2>;	// line number in gpio port (not global)
		output-high;
		line-name = "wl-enable";
	};
};

&gpio2 {
	compatible = "rockchip,gpio-bank";
	reg = <0x0 0xfe750000 0x0 0x100>;
	interrupts = <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>;
	clocks = <&cru PCLK_GPIO2>, <&cru DBCLK_GPIO2>;
	gpio-controller;
	gpio-ranges = <&pinctrl 0 64 32>;
	#gpio-cells = <2>;
	interrupt-controller;
	#interrupt-cells = <2>;
	gpio-line-names = "","","","","","","","","","","","","","","","","","","","","","","","","","","","","bt-enable","buff-enable","","";

	bt-enable {
		gpio-hog;
		gpios = <28 2>;	// line number in gpio port (not global)
		output-high;
		line-name = "bt-enable";
	};
	buff-enable {
		gpio-hog;
		gpios = <29 2>;	// line number in gpio port (not global)
		output-high;
		line-name = "buff-enable";
	};
};

&gpio4 {
	compatible = "rockchip,gpio-bank";
	reg = <0x0 0xfe770000 0x0 0x100>;
	interrupts = <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>;
	clocks = <&cru PCLK_GPIO4>, <&cru DBCLK_GPIO4>;
	gpio-controller;
	gpio-ranges = <&pinctrl 0 128 32>;
	#gpio-cells = <2>;
	interrupt-controller;
	#interrupt-cells = <2>;
	line_en-buff {
		gpio-hog;
		gpios = <20 2>;	// line number in gpio port (not global)
		output-high;
		line-name = "en-buffer";
	};
};
