#!/bin/sh

# 1. Создаем точку монтирования
mkdir -p /mnt/rootfs_a

# 2. Монтируем rootfs_a строго с mmc0 (так как SD-карта определилась как mmc0)
mount /dev/mmc0.rootfs_a /mnt/rootfs_a

# 3. Назначаем переменные через команду global (БЕЗ использования знака '=' в начале строки)
global bootm.image="/mnt/rootfs_a/boot/Image.gz"
global linux.bootargs.dyn.root="root=PARTUUID=b921b045-1df0-41c3-af44-4c6f280d3fae rw rootwait"
