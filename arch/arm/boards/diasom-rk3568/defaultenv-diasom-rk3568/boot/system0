#!/bin/sh

# Создаем точку монтирования (ошибки скрывать не нужно, husher их пропустит)
mkdir -p /mnt/rootfs_a
mount /dev/mmc0.rootfs_a /mnt/rootfs_a

# Передаем параметры ядра
global.bootm.image=/mnt/rootfs_a/boot/Image.gz
global.bootm.oftree=/mnt/rootfs_a/boot/rk3568-diasom-som-evb.dtb
global.linux.bootargs.dyn.root="root=PARTUUID=b921b045-1df0-41c3-af44-4c6f280d3fae ro rootwait"
