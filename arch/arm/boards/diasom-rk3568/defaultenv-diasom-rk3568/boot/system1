#!/bin/sh

# Создаем точку монтирования
mkdir -p /mnt/rootfs_b

# УНИВЕРСАЛЬНЫЙ АВТОПОИСК: проверяем, где физически создался нужный раздел GPT
if [ -e /dev/mmc0.rootfs_b ]; then
    CURRENT_DEV="mmc0"
    LINUX_DEV="mmcblk0"
elif [ -e /dev/mmc1.rootfs_b ]; then
    CURRENT_DEV="mmc1"
    LINUX_DEV="mmcblk1"
else
    # Резервный вариант
    CURRENT_DEV="mmc0"
    LINUX_DEV="mmcblk0"
fi

# Монтируем rootfs_b
mount /dev/${CURRENT_DEV}.rootfs_b /mnt/rootfs_b

# Загружаем ядро Linux
global bootm.image="/mnt/rootfs_b/boot/Image.gz"

# Передаем Linux правильный корень и активируем вывод консоли Rockchip (ttyFIQ0)
global linux.bootargs.dyn.root="root=/dev/${LINUX_DEV}p5 rw rootwait console=ttyFIQ0,1500000n8 init=/sbin/init"
